      "candidate_ids": [
        "qlib.kmid",
        "qlib.klen"
      ],
      "inputs": {
        "open": 10,
        "high": 15,
        "low": 9,
        "close": 12
      },
      "expected": [
        0.2,
        0.6
      ]
    },
    {
